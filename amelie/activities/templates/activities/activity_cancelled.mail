{% extends "iamailer/email_basic.mail" %}
{% load i18n htmlify only %}
{% block subject %}{% blocktrans with activity=activity.summary %}Cancellation of {{ activity }}{% endblocktrans %}{% endblock %}
{% block content %}{% htmlify %}{% blocktrans with name=recipient.first_name %}Dear {{ name }},{% endblocktrans %}
{% blocktrans with activity=activity.summary %}
You receive this email because you were enrolled for {{ activity }}. This activity has been cancelled.
{% endblocktrans %}{% endhtmlify %}
{% if participation_costs > 0 %}{% htmlify %}{% blocktrans with costs=participation_costs %}The total costs were {{ costs }} euro.{% endblocktrans %}{% endhtmlify %}
{% if has_mandate %}{% htmlify %}{% blocktrans %}These costs will be refunded on your personal tab.{% endblocktrans %}{% endhtmlify %}
{% else %}{% htmlify %}{% blocktrans %}If you already paid for this activity, please come by the association room or contact the treasurer to re-collect your payment. If you had not paid yet you do not need to do anything.{% endblocktrans %}{% endhtmlify %}
{% endif %}{% endif %}{% blocktrans %}
Kind regards,{% endblocktrans %}
{% onlyhtml %}<br/>{% endonlyhtml %}Inter-{% onlyhtml %}<i>{% endonlyhtml %}Actief{% onlyhtml %}</i>{% endonlyhtml %}{% endblock %}
